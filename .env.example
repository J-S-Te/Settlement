SETTLEMENT_MYSQL_DSN=settlement:change-me@tcp(settlement-db:3306)/settlement?parseTime=true&charset=utf8mb4&loc=UTC
SETTLEMENT_HTTP_ADDR=:8085
SETTLEMENT_PUBLIC_ORIGIN=https://platform.example.com
SETTLEMENT_DEVELOPMENT_AUTH=false
SETTLEMENT_INTEGRATION_ENABLED=true
SETTLEMENT_OUTBOX_BATCH_SIZE=50
PLATFORM_BASE_URL=https://platform.example.com
PLATFORM_ENVIRONMENT_CODE=prod
OIDC_ISSUER=https://platform.example.com/realms/platform
OIDC_BACKCHANNEL_BASE_URL=http://keycloak:8080/realms/platform
OIDC_CLIENT_ID=settlement-web
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://platform.example.com/settlement/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://platform.example.com/settlement/logged-out
OIDC_TENANT_ID=
OIDC_SESSION_COOKIE_NAME=settlement_session
OIDC_SESSION_COOKIE_SECURE=true
OIDC_SESSION_ENCRYPTION_KEY_BASE64=
OIDC_SESSION_IDLE_TTL=30m
OIDC_SESSION_ABSOLUTE_TTL=8h
# 中央模式下两项本地期限仅兼容旧模式，业务期限从基础平台读取。
CENTRAL_SESSION_ENABLED=false
CENTRAL_SESSION_PUBLIC_BASE_URL=
# 中央会话只读查询缓存（毫秒）。0=关闭；>0 表示最多缓存这么久，上限 5000。
# 关闭时每次请求都直达平台，行为与引入缓存前完全一致。
CENTRAL_SESSION_CACHE_MS=0
CONTRACT_INTEGRATION_CLIENT_ID=contract-settlement-publisher
CONTRACT_INTEGRATION_AUDIENCE=settlement-api
# 催收人员选择使用基础平台机器目录；客户端只授予 owner_directory.read。
PLATFORM_PERSONNEL_DIRECTORY_URL=http://platform-api:8080
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_ID=
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_SECRET=
SETTLEMENT_CRM_CREDIT_SYNC_ENABLED=false
# 结算→CRM 回款/冲销信用事实同步。scope 固定为 customer.credit.payment.ingest，
# 必须与 CRM 机器权限白名单及平台受控用途 crm_credit_payment_ingest 一致（启动期校验，
# 任何历史名字如 crm.credit.payment.ingest 都会让进程失败关闭）。
# 客户端凭据由平台受控接入按 settlement-<环境>-crm-credit-ingest 注入，不要手工填写。
CRM_CREDIT_SYNC_ENDPOINT=http://customer-and-opportunity-api:8080/api/v1/internal/credit/payment-events
CRM_CREDIT_TOKEN_URL=http://platform-api:8080/oauth2/token
CRM_CREDIT_CLIENT_ID=settlement-prod-crm-credit-ingest
CRM_CREDIT_CLIENT_SECRET=
CRM_CREDIT_SCOPE=customer.credit.payment.ingest
SETTLEMENT_NOTIFICATION_CLIENT_ID=
SETTLEMENT_NOTIFICATION_CLIENT_SECRET=
SETTLEMENT_AUDIT_CLIENT_ID=
SETTLEMENT_AUDIT_CLIENT_SECRET=
# BIZ-XAPI-10：审计目的地是否必开。显式 true/false 优先；留空时 APP_ENV=production
# 或 PLATFORM_ENVIRONMENT_CODE=prod 视为必开。必开而凭据不全时 settlement-worker
# 启动失败（fail-closed，不会带着“审计永不投递”继续跑）；非必开缺失只降级并告警。
# 显式 false 属于有意的回滚开关，启动日志会留下 WARN 痕迹。
SETTLEMENT_AUDIT_REQUIRED=
# 开票渠道必须二选一。manual 审批后只允许人工登记；tax_adapter 审批后只投递税控命令。
SETTLEMENT_INVOICE_ISSUANCE_MODE=manual
SETTLEMENT_TAX_ADAPTER_URL=
SETTLEMENT_TAX_STATUS_URL=
SETTLEMENT_TAX_TOKEN_URL=
SETTLEMENT_TAX_CLIENT_ID=
SETTLEMENT_TAX_CLIENT_SECRET=
SETTLEMENT_TAX_PROVIDER_CODE=default
# 税控回调使用独立机器身份；生产令牌必须含 tenant/application/environment 和 settlement.tax_result.ingest scope。
SETTLEMENT_TAX_RESULT_INGEST_ENABLED=false
SETTLEMENT_TAX_RESULT_CLIENT_ID=
SETTLEMENT_TAX_RESULT_AUDIENCE=settlement-api
SETTLEMENT_TAX_RESULT_APPLICATION_CODE=tax_adapter
# 仅开发认证模式使用，生产禁止配置静态 Bearer Token。
SETTLEMENT_TAX_RESULT_BEARER_TOKEN=
# 报表文件网关：默认 legacy；切换 dual/required 前先配置以下占位变量。
SETTLEMENT_FILE_GATEWAY_MODE=legacy
SETTLEMENT_FILE_GATEWAY_APPLICATION_ID=settlement
FILE_GATEWAY_URL=http://file-gateway:8086
FILE_GATEWAY_TOKEN_URL=http://platform-api:8080/oauth2/token
FILE_GATEWAY_CLIENT_ID=
FILE_GATEWAY_CLIENT_SECRET=
FILE_GATEWAY_SCOPE=platform:file:upload platform:file:bind platform:file:download

# 负责项目分配前查询项目系统权威引用。四项全填后启用，使用独立只读机器身份。
SETTLEMENT_PROJECT_REFERENCE_URL=
SETTLEMENT_PROJECT_REFERENCE_TOKEN_URL=
SETTLEMENT_PROJECT_REFERENCE_CLIENT_ID=
SETTLEMENT_PROJECT_REFERENCE_CLIENT_SECRET=
# BIZ-XAPI-05b：结算 worker 按周期重拉上表项目的权威引用，把已换合同/已失效的
# 项目在本地收口为 active=false，避免助理继续读写旧合同范围。默认 10m；
# 显式 0 关闭刷新（关闭后只剩分配时的人工拉取，范围可能陈旧）。
# 批量上限 1..200，默认 50；机器身份复用上面的 SETTLEMENT_PROJECT_REFERENCE_*。
PROJECT_REFERENCE_SYNC_INTERVAL=10m
PROJECT_REFERENCE_SYNC_BATCH_SIZE=50

# 历史合同财务暂存入口；关闭不影响已受理记录恢复、对账及放行
SETTLEMENT_CONTRACT_IMPORT_ENABLED=false

# 收款计划与合同金额的覆盖差额守卫（SET-04）。人工创建/调整/确认计划后，
# 若计划合计与合同金额的差额百分比超过 GAP 阈值，或单期金额降幅超过 DROP 阈值，
# 必须由持有 settlement.finance.override 的财务负责人放行（否则 409 拒绝）。
# 等号两边为百分比；留空或非法值回落到默认阈值，不会关闭守卫。
SETTLEMENT_PLAN_COVERAGE_GAP_PERCENT=5
SETTLEMENT_PLAN_COVERAGE_DROP_PERCENT=50

# 独立结算财务看板来源；仅由受控settlement_dashboard_read用途启用。
# CLIENT_ID固定JWT sub，OAUTH_CLIENT_ID固定注册记录oauth_client_id；不是同一个字段。
SETTLEMENT_DASHBOARD_MACHINE_ENABLED=false
SETTLEMENT_DASHBOARD_MACHINE_CLIENT_ID=
SETTLEMENT_DASHBOARD_MACHINE_OAUTH_CLIENT_ID=
SETTLEMENT_DASHBOARD_MACHINE_AUDIENCE=basic-platform-application
SETTLEMENT_DASHBOARD_MACHINE_ISSUER=basic-platform
SETTLEMENT_DASHBOARD_MACHINE_PUBLIC_KEY_PATH=
SETTLEMENT_DASHBOARD_MACHINE_CALLER_APPLICATION_CODE=data_analysis
SETTLEMENT_DASHBOARD_MACHINE_CALLER_ENVIRONMENT_CODE=
SETTLEMENT_DASHBOARD_MACHINE_REQUIRED_SCOPE=dashboard.settlement.read
