OIDC_SESSION_COOKIE_SECURE=true
OIDC_SESSION_ENCRYPTION_KEY_BASE64=
OIDC_SESSION_IDLE_TTL=30m
OIDC_SESSION_ABSOLUTE_TTL=8h
CONTRACT_INTEGRATION_CLIENT_ID=contract-settlement-publisher
CONTRACT_INTEGRATION_AUDIENCE=settlement-api
# 催收人员选择使用基础平台机器目录；客户端只授予 owner_directory.read。
PLATFORM_PERSONNEL_DIRECTORY_URL=http://platform-api:8080
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_ID=
PLATFORM_PERSONNEL_DIRECTORY_CLIENT_SECRET=
