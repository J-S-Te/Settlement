CRM_CREDIT_SYNC_ENDPOINT=http://customer-and-opportunity-api:8080/api/v1/internal/credit/payment-events
CRM_CREDIT_TOKEN_URL=http://platform-api:8080/oauth2/token
CRM_CREDIT_CLIENT_ID=settlement-credit-publisher
CRM_CREDIT_CLIENT_SECRET=
CRM_CREDIT_SCOPE=crm.credit.payment.ingest
SETTLEMENT_NOTIFICATION_CLIENT_ID=
SETTLEMENT_NOTIFICATION_CLIENT_SECRET=
SETTLEMENT_AUDIT_CLIENT_ID=
SETTLEMENT_AUDIT_CLIENT_SECRET=
SETTLEMENT_TAX_ADAPTER_URL=
SETTLEMENT_TAX_TOKEN_URL=
